<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F7FA">

    <!-- Custom Top Header Bar Section (Matches Main Screen Consistency) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/primaryColor"
        android:padding="16dp"
        android:gravity="center_vertical"
        android:elevation="4dp">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/logo"
            android:layout_marginEnd="12dp"
            android:contentDescription="App Logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Electric Bill Estimator"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Scrollable Body Container to prevent clipping issues on small screens -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Card 1: Record Modification Form Fields -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Billing Month Selection Row -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Modify Billing Month"
                        android:textStyle="bold"
                        android:textColor="#333333"
                        android:textSize="14sp"
                        android:layout_marginBottom="6dp"/>

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@android:drawable/btn_dropdown"
                        android:layout_marginBottom="16dp">
                        <Spinner
                            android:id="@+id/spinnerDetailMonth"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:entries="@array/months_array"
                            android:spinnerMode="dropdown"/>
                    </FrameLayout>

                    <!-- Electricity Unit (kWh) Field -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Modify Consumption Unit (kWh)"
                        android:textStyle="bold"
                        android:textColor="#333333"
                        android:textSize="14sp"
                        android:layout_marginBottom="6dp"/>

                    <EditText
                        android:id="@+id/etDetailKwh"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:padding="12dp"
                        android:background="@android:drawable/editbox_background_normal"
                        android:layout_marginBottom="16dp"
                        android:textSize="16sp"/>

                    <!-- Rebate Seekbar Slider Section -->
                    <TextView
                        android:id="@+id/tvDetailRebateLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rebate: 0%"
                        android:textStyle="bold"
                        android:textColor="#333333"
                        android:textSize="14sp"
                        android:layout_marginBottom="6dp"/>

                    <SeekBar
                        android:id="@+id/seekDetailRebate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="5"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:layout_marginBottom="8dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Card 2: Current Record Saved Summary Details -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Calculation Breakdown"
                        android:textColor="@color/primaryColor"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp"/>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E0E0E0"
                        android:layout_marginBottom="12dp"/>

                    <TextView
                        android:id="@+id/tvDetailBreakdown"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#444444"
                        android:textSize="16sp"
                        android:lineSpacingMultiplier="1.3"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Card 3: Form Interaction Modifiers (Update vs Delete Buttons) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp"> <!-- FIXED: Changed from auto to 16dp -->

                <Button
                    android:id="@+id/btnUpdate"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="54dp"
                    android:text="Update"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:layout_marginEnd="6dp"
                    android:backgroundTint="@color/primaryColor"
                    app:cornerRadius="8dp"/>

                <Button
                    android:id="@+id/btnDelete"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="54dp"
                    android:text="Delete Record"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:layout_marginStart="6dp"
                    android:backgroundTint="#D32F2F"
                    android:textColor="#FFFFFF"
                    app:cornerRadius="8dp"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>